# D+J SprachCoach — Umgebungsvariablen
# Kopieren Sie diese Datei zu ".env" und tragen Sie Ihren Schlüssel ein.

# Anthropic API-Key (erforderlich für KI-Gespräch & Sprachanalyse)
ANTHROPIC_API_KEY=sk-ant-...

# Optionale Modell-Überschreibungen
CHAT_MODEL=claude-sonnet-5
ANALYSIS_MODEL=claude-sonnet-5

# Port (lokal; auf Render wird PORT automatisch gesetzt)
PORT=3000
